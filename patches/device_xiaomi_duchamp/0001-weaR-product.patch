From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: RidTheWann <wear-os@example.invalid>
Date: Sat, 3 Oct 2026 00:00:00 +0000
Subject: [PATCH] duchamp: add WeaR OS product

Reference: snapboss/device_xiaomi_duchamp @ 50f301982df14af45af137ba87c565a459a7e65c

diff --git a/AndroidProducts.mk b/AndroidProducts.mk
--- a/AndroidProducts.mk
+++ b/AndroidProducts.mk
@@ -7,3 +7,4 @@
PRODUCT_MAKEFILES := \
-    $(LOCAL_DIR)/lineage_duchamp.mk
+    $(LOCAL_DIR)/wear_duchamp.mk
+
+COMMON_LUNCH_CHOICES := wear_duchamp-userdebug
diff --git a/wear_duchamp.mk b/wear_duchamp.mk
new file mode 100644
--- /dev/null
+++ b/wear_duchamp.mk
@@ -0,0 +1,31 @@
+#
+# WeaR OS product for Xiaomi/POCO duchamp.
+#
+# SPDX-License-Identifier: Apache-2.0
+#
+
+$(call inherit-product, $(SRC_TARGET_DIR)/product/core_64_bit_only.mk)
+$(call inherit-product, $(SRC_TARGET_DIR)/product/full_base_telephony.mk)
+$(call inherit-product, device/xiaomi/duchamp/device.mk)
+$(call inherit-product, vendor/lineage/config/common_full_phone.mk)
+
+# Keep the reference product selector unchanged during bring-up.
+WITH_GMS := true
+
+PRODUCT_NAME := wear_duchamp
+PRODUCT_DEVICE := duchamp
+PRODUCT_MANUFACTURER := Xiaomi
+PRODUCT_BRAND := POCO
+PRODUCT_MODEL := 2311DRK48G
+PRODUCT_SYSTEM_NAME := duchamp_global
+
+PRODUCT_GMS_CLIENTID_BASE := android-xiaomi
+
+# Keep reference compatibility properties unchanged for the first bring-up.
+PRODUCT_BUILD_PROP_OVERRIDES += \
+    BuildDesc="missi-user 16 BP3A.250905.031.A3 OS2.0.206.0.VNLMIXM release-keys" \
+    BuildFingerprint=POCO/duchamp_global/duchamp:14/UP1A.230905.011/OS2.0.206.0.VNLMIXM:user/release-keys \
+    DeviceProduct=$(PRODUCT_SYSTEM_NAME)
+
+WEAR_OS_VERSION := 0.1.0-alpha
+WEAR_OS_BUILD_TYPE := UNOFFICIAL
+PRODUCT_SYSTEM_PROPERTIES += \
+    ro.wear.os.name=WeaR_OS \
+    ro.wear.os.version=$(WEAR_OS_VERSION) \
+    ro.wear.os.build_type=$(WEAR_OS_BUILD_TYPE)